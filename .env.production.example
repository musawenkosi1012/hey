# Production Environment Configuration
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production

# Security - CHANGE THIS IN PRODUCTION!
SECRET_KEY=your-secret-key-here-use-something-random-and-secure

# Database
DATABASE_URL=postgresql://user:password@host:port/database
# Or for SQLite: sqlite:///chronisense.db

# OpenAI Configuration (REQUIRED for AI chatbot)
# Get your API key from https://platform.openai.com/
# The chatbot will work without this but will use fallback responses only
OPENAI_API_KEY=sk-proj-your-api-key-here

# Twilio Configuration (Optional - for SMS alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Logging Configuration
# Available levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Server Configuration (for production)
# PORT=5000
# HOST=0.0.0.0
